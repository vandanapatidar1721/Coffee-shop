# Coffee Shop API — copy to .env and fill in values
# Run from back-end/: cp example.env .env  (or copy manually on Windows)

# Required — used to sign and verify JWT auth tokens (use a long random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Optional — server port (default: 5000)
PORT=5000

# Optional — MongoDB connection string (default: mongodb://localhost:27017/coffeeshop)
MONGO_URI=mongodb://localhost:27017/coffeeshop
